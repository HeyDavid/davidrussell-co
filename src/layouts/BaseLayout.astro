---
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "David Russell",
  description = "Solo operator and writer in South Florida. I run a small portfolio of companies and write about what building them teaches me.",
  image = "/og/site.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://davidrussell.co").toString();
const socialImage = new URL(image, Astro.site ?? "https://davidrussell.co").toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/rss+xml" title="David Russell: writing" href="/rss.xml">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={socialImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImage}>
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-sig-32.png">
<link rel="icon" type="image/x-icon" href="/assets/favicon-sig.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-sig.png">
<meta name="theme-color" content="#ffffff">
<meta name="color-scheme" content="light">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Asul:wght@400;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<script is:inline type="speculationrules">{"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}</script>
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "374371c09f5d4d4b83fe5e0a2f55cbc6"}'></script>
<!-- Umami analytics, self-hosted; CF beacon kept as redundancy -->
<script is:inline defer src="https://umami-nine-gilt.vercel.app/script.js" data-website-id="944e0f3c-fc3f-4251-95fe-e70ee25234d4"></script>
<title>{title}</title>
<slot name="head" />
</head>
<body>

<div class="page">
  <slot />
</div>

<script is:inline>
  /* gentle reveal from a visible resting state: nothing is hidden if this never runs */
  (function(){
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) return;
    var els = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
    els.forEach(function(el){ if (el.getBoundingClientRect().top > window.innerHeight * 0.92) el.classList.add("pending"); });
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.remove("pending"); obs.unobserve(e.target); } });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
    els.forEach(function(el){ if (el.classList.contains("pending")) obs.observe(el); });
  })();
</script>

</body>
</html>

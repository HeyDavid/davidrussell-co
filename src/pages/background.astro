---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const record = [
  { name: "Marketing operator", yr: "10+ years", why: "Paid, content, brand, productized. Most channels, most stages, across dozens of industries." },
  { name: "Moolaguides", yr: "founder & exit", why: "Grew a Wix site into a marketplace doing $400K+ a year, then sold it." },
  { name: "Syllble", yr: "co-founder", why: "Collaborative fiction publishing. 105+ novels and counting." },
  { name: "Let's Chat", yr: "current", why: "The AI front desk system for local businesses. Phones, reviews, follow-up, reporting." },
  { name: "Cura", yr: "current", why: "The same front desk, built for dental practices." },
  { name: "ScamCapital", yr: "current", why: "Plain-English case files on how specific scams work, step by step." },
  { name: "Computer Input", yr: "family business", why: "My parents' cabling and networking firm, 40 years in. I run the marketing and Jackie, their AI receptionist." },
  { name: "Maker Margin", yr: "side project", why: "A free fee calculator for Etsy sellers." },
  { name: "Magic", yr: "20+ years", why: "Card and coin work since I was a kid. Still the best icebreaker I've got." },
];
---

<BaseLayout
  title="About · David Russell"
  description="A decade in marketing, a marketplace grown from a Wix site to $400,000 a year, and the small companies I run now."
>
  <Header />
  <main>
    <article class="work">
      <a href="/" class="back">← Home</a>

      <header class="work-head">
        <div class="dateline"><b>About</b></div>
        <h1>A Wix site, a marketplace, and a <em>decade of shipping</em>.</h1>
        <p class="work-lede">
          I grew what started as a Wix site into a marketplace doing over
          $400,000 a year in sales, then sold it. Behind that, a decade of
          marketing: my own startups, and consulting across dozens of
          industries. Now I run a small portfolio of companies and build
          websites and funnels for people who need them to work.
        </p>
      </header>

      <section class="work-block">
        <h2>The record.</h2>
        <ul class="record">
          {record.map((r) => (
            <li class="record-row">
              <div class="record-name">{r.name}<span class="yr">{r.yr}</span></div>
              <div class="record-why">{r.why}</div>
            </li>
          ))}
        </ul>
      </section>

      <section class="work-block">
        <h2>How the work goes.</h2>
        <p class="work-prose">
          The shape of the work hasn&rsquo;t changed much: find what&rsquo;s actually
          useful, ship it cleanly, then keep tightening the loop between the
          offer, the audience, and the thing they buy. Some of it was mine end
          to end. A lot of it was alongside operators who needed a marketing
          brain that could also build the site, write the copy, and run the funnel.
        </p>
        <p class="work-prose" style="margin-top:18px;">
          If that&rsquo;s the kind of help you&rsquo;re after, <a href="/work-with-me/marketing/">here&rsquo;s how to work with me</a>,
          or email <a href="mailto:david@letschatmarketing.com">david@letschatmarketing.com</a>.
        </p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout
  title="Let's Chat · David Russell"
  description="Let's Chat Marketing: the AI front desk system for local businesses."
  noindex={true}
>
  <Header />
  <main>
    <article class="work">
      <a href="/" class="back">← Home</a>

      <header class="work-head">
        <div class="dateline"><b>Ventures</b></div>
        <h1>Let&rsquo;s Chat.</h1>
        <p class="work-lede">
          Let&rsquo;s Chat is the company I run for local businesses: an AI front
          desk that answers the phone, plus the reviews, follow-up texts, and
          monthly reporting around it.
        </p>
        <a class="work-cta" href="https://letschatmarketing.com" target="_blank" rel="noopener">Visit letschatmarketing.com →</a>
      </header>
    </article>
  </main>
  <Footer />
</BaseLayout>

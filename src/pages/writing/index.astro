---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("writing", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const dateOf = (post: (typeof posts)[number]) =>
  post.data.status === "coming-soon" ? "Coming soon" : formatDate(post.data.publishDate);

const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Writing · David Russell"
  description="Essays and notes from David Russell. What I tried, what it cost, what I still don't know."
>
  <Header />
  <main>
    <article class="reading">
      <a href="/" class="back">← Home</a>

      <header class="reading-head">
        <div class="level"><span class="bar" aria-hidden="true"></span><span class="lbl">Essays and notes</span></div>
        <h1>Writing.</h1>
        <p class="reading-lede">
          Essays and notes. What I tried, what it cost, what I still
          don&rsquo;t know. Newest first.
        </p>
        <p class="feed-note">Follow by <a href="/#subscribe">email</a> or <a href="/rss.xml">RSS</a>.</p>
      </header>

      {hasPosts ? (
        <ul class="entries index-entries">
          {posts.map((post) => (
            <li class="entry">
              <a href={`/writing/${post.id}/`}>
                <div class="entry-dateline">
                  <span class="entry-format">{cap(post.data.format)}</span>
                  <span class="sep">·</span>
                  <span>{dateOf(post)}</span>
                  {post.data.readTime && <><span class="sep">·</span><span>{post.data.readTime}</span></>}
                </div>
                <div class="entry-title" style={`view-transition-name: vt-${post.id}`}>{post.data.title}</div>
                {post.data.description && <div class="entry-dek">{post.data.description}</div>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">
          Nothing published here yet. <a href="/#subscribe">Leave your email on the home page</a> to get the first one.
        </p>
      )}
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .reading{max-width:760px;margin:0 auto;padding:clamp(34px,6vw,72px) var(--pad) clamp(72px,10vw,120px)}
  .reading-head{margin-bottom:clamp(28px,4vw,44px)}
  .level{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .level .bar{width:64px;height:10px;background:var(--accent);flex:none}
  .level .lbl{font-weight:600;font-size:15.5px;color:var(--ink)}
  .reading-head h1{font-family:var(--disp);font-weight:700;font-size:clamp(48px,8vw,88px);letter-spacing:-.012em;line-height:1;color:var(--ink);border-bottom:3px solid var(--ink);padding-bottom:18px}
  .reading-lede{font-family:var(--grot);font-size:clamp(18px,2vw,21px);line-height:1.55;color:var(--ink-soft);max-width:54ch;margin-top:18px}
  .feed-note{font-size:14px;color:var(--ink-faint);margin-top:14px}
  .feed-note a{color:var(--ink);border-bottom:2px solid var(--accent)}
  .index-entries .entry>a{padding:26px 0}
  .empty-note{font-size:18px;color:var(--ink-soft);padding:24px 0;border-top:1px solid var(--line)}
  .empty-note a{color:var(--ink);border-bottom:2px solid var(--accent)}
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";

const all = await getCollection("writing", ({ data }) => !data.draft);
const posts = all
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
const latest = posts[0];
const more = posts.slice(1);

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const ventures = [
  { name: "Cura", url: "https://curadental.co", domain: "curadental.co", mark: "cura",
    desc: "An AI front desk, website, and review engine for dental practices.", status: "Product" },
  { name: "Let’s Chat", url: "https://letschatmarketing.com", domain: "letschatmarketing.com", mark: "letschat",
    desc: "The AI front desk system for local businesses: the phone, the reviews, the follow-up texts, the monthly report.", status: "On real phone lines today" },
  { name: "ScamCapital", url: "https://scamcapital.com", domain: "scamcapital.com", mark: "scamcapital",
    desc: "Plain-English case files on how specific scams work, step by step.", status: "Live case directory" },
  { name: "Computer Input", url: "https://computerinput.com", domain: "computerinput.com", mark: "computerinput",
    desc: "My parents’ cabling and networking firm. I run the marketing and Jackie, their AI receptionist.", status: "Family business, 40 years in" },
];

const title = "David Russell · small, useful companies";
const description = "Solo operator in South Florida. I run a small portfolio of companies and write about what building them teaches me.";
---

<BaseLayout title={title} description={description} image="/og-2026b.png">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://davidrussell.co/#person","name":"David Russell","url":"https://davidrussell.co/","jobTitle":"Solo operator and writer","sameAs":["https://www.linkedin.com/in/heydavidr/","https://x.com/heydavidr","https://github.com/HeyDavid"]},{"@type":"WebSite","@id":"https://davidrussell.co/#website","url":"https://davidrussell.co/","name":"David Russell","description":"David Russell, solo operator and writer in South Florida.","publisher":{"@id":"https://davidrussell.co/#person"}}]}</script>
  </Fragment>

  <Header />
  <main class="home">

    <section class="hero" id="top"><div class="wrap">
      <div class="hero-copy">
        <p class="intro">David Russell, solo operator in South Florida. I run a small portfolio of companies and write about what building them teaches me.</p>
        <div class="level"><span class="bar" aria-hidden="true"></span><span class="lbl">Latest essay</span><span class="meta">{cap(latest.data.format)} · {fmt(latest.data.publishDate)}{latest.data.readTime ? ` · ${latest.data.readTime}` : ""}</span></div>
        <h1><a href={`/writing/${latest.id}/`} style={`view-transition-name: vt-${latest.id}`}>{latest.data.title}</a></h1>
        <p class="excerpt">{latest.data.description}</p>
        <a class="read" href={`/writing/${latest.id}/`} data-umami-event="hero_read_click">Read the essay <span class="arr" aria-hidden="true">&rarr;</span></a>
      </div>
      <figure class="heroimg">
        <img src="/assets/hero-bridge.jpg" alt="A wooden suspension bridge leading into a forest, Whistler" width="1000" height="1333" fetchpriority="high" decoding="async">
      </figure>
    </div></section>

    <section class="hear"><div class="wrap">
      <div class="hearbox reveal">
        <img src="/assets/hear-desk.jpg" alt="A front-desk phone with the handset just lifted, a notepad and a yellow pen on a light wood counter" width="1400" height="933" loading="lazy" decoding="async">
        <div class="hearcopy">
          <h2>Hear one of them work.</h2>
          <p>An AI front desk that answers, qualifies, and books. Enter your number at curadental.co/hear and it calls you within seconds. Ask it to book you, ask about hours, switch it to Spanish.</p>
          <a class="go" href="https://curadental.co/hear" target="_blank" rel="noopener" data-umami-event="lab_click" data-umami-event-project="cura-hear">Get the call <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div></section>

    <section class="sec" id="ventures"><div class="wrap">
      <div class="sechead reveal"><h2>Current ventures.</h2></div>
      <p class="subnote">Four small companies. Each one is where the writing comes from.</p>
      <ul class="rows">
        {ventures.map((v) => (
          <li class="row"><a href={v.url} target="_blank" rel="noopener">
            <span class="mark" aria-hidden="true"><img class="m-base" src={`/assets/marks/${v.mark}-base.png`} alt="" width="72" height="72" loading="lazy" decoding="async"><img class="m-yel" src={`/assets/marks/${v.mark}-yellow.png`} alt="" width="72" height="72" loading="lazy" decoding="async"></span>
            <span class="name">{v.name}<span class="st">{v.status}</span></span>
            <span class="desc">{v.desc}</span>
            <span class="go">{v.domain} <span aria-hidden="true">&rarr;</span></span>
          </a></li>
        ))}
      </ul>
    </div></section>

    <section class="sec writing" id="writing"><div class="wrap">
      <div>
        <div class="sechead reveal"><h2>More writing.</h2><a class="all" href="/writing/">Read everything <span aria-hidden="true">&rarr;</span></a></div>
        <p class="subnote">Essays and notes. What I tried, what it cost, what I still don&rsquo;t know.</p>
        <ul class="rows">
          {more.map((post) => (
            <li class="row wrow"><a href={`/writing/${post.id}/`}>
              <span class="st">{cap(post.data.format)} · {fmt(post.data.publishDate)}{post.data.readTime ? ` · ${post.data.readTime}` : ""}</span>
              <span><span class="name" style={`view-transition-name: vt-${post.id}`}>{post.data.title}</span><span class="desc">{post.data.description}</span></span>
            </a></li>
          ))}
        </ul>
      </div>
      <img class="wimg reveal" src="/assets/forest-lights.jpg" alt="A forest path at night, lit blue and green, Whistler" width="900" height="1200" loading="lazy" decoding="async">
    </div></section>

    <section class="sec about" id="about"><div class="wrap">
      <img src="/assets/headshot.jpg" alt="David Russell" width="600" height="750" loading="lazy" decoding="async">
      <div>
        <div class="sechead reveal"><h2>About David.</h2></div>
        <p class="first">I&rsquo;m David, a solo operator in South Florida. I grew a Wix site into a marketplace doing $400K+ a year, sold it, and spent a decade doing marketing across dozens of industries.</p>
        <p>Now I build small, useful companies and write about the work. If you need marketing or a website that has to earn its keep, we should talk.</p>
        <div class="links" id="work"><a href="/background/">The longer version</a><a href="/work-with-me/marketing/" data-umami-event="work_cta_click" data-umami-event-location="about">How to work with me</a></div>
      </div>
    </div></section>

    <section class="sub" id="subscribe"><div class="wrap">
      <div class="subbox reveal">
        <div>
          <h2>Build small. Own it. Compound.</h2>
          <p>Occasional essays, no schedule. Reply to any of them.</p>
        </div>
        <form class="form" id="sub2">
          <label for="sub-email" class="vh">Email address</label>
          <input type="email" id="sub-email" name="email" placeholder="your email" autocomplete="email" required>
          <button type="submit" data-umami-event="subscribe_submit" data-umami-event-location="footer">Get new essays</button>
          <span class="cap">Occasional essays. No schedule, no spam. I read every reply.</span>
        </form>
      </div>
    </div></section>

  </main>
  <Footer />
</BaseLayout>

<script is:inline>
(function(){
  if(!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)){ document.documentElement.classList.add('js'); }
  var f=document.getElementById('sub2'); if(!f) return;
  f.addEventListener('submit',function(ev){
    ev.preventDefault();
    var input=f.querySelector('input'), btn=f.querySelector('button'), cap=f.querySelector('.cap');
    var email=(input.value||'').trim(); if(!email) return;
    btn.disabled=true; var old=btn.textContent; btn.textContent='Sending…';
    var d=new FormData();
    d.set('email',email); d.set('utm_source','davidrussell.co'); d.set('utm_medium','footer'); d.set('tags','dr-subscriber'); d.set('referring_site','davidrussell.co');
    fetch('https://embeds.beehiiv.com/pub_ed495df0-b44a-47ba-939c-eeb46089e27b',{method:'POST',mode:'no-cors',body:d}).finally(function(){
      f.reset(); btn.disabled=false; btn.textContent=old;
      if(cap){ cap.textContent='Sent. A confirmation email should arrive within a minute. If it does not, email me and I will add you by hand.'; cap.classList.add('done'); }
    });
  });
})();
</script>

<style>
  .home .wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--pad)}
  .home h1,.home h2{font-family:var(--disp);font-weight:700;line-height:1.05;letter-spacing:-.012em;text-wrap:balance}
  .home h2{font-size:clamp(28px,3.4vw,40px)}
  .vh{position:absolute;left:-9999px}

  /* hero */
  .hero .wrap{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(28px,5vw,64px);align-items:center;padding-block:clamp(28px,5vw,60px) clamp(24px,4vw,48px)}
  .hero>.wrap>*{min-width:0}
  .intro{font-size:17.5px;color:var(--dim);max-width:50ch;line-height:1.55}
  .level{display:flex;align-items:center;gap:12px;margin-top:30px;flex-wrap:wrap}
  .level .bar{width:64px;height:10px;background:var(--accent);flex:none}
  .level .lbl{font-weight:600;font-size:15.5px}
  .level .meta{color:var(--dim);font-size:15.5px}
  .hero h1{font-size:clamp(40px,7vw,68px);margin-top:16px}
  .hero h1 a:hover{text-decoration:underline;text-decoration-color:var(--accent);text-decoration-thickness:6px;text-underline-offset:8px}
  .excerpt{margin-top:18px;font-size:clamp(18px,2vw,21px);line-height:1.55;color:var(--dim);max-width:56ch}
  .read{display:inline-flex;align-items:center;gap:12px;margin-top:22px;font-weight:600;font-size:17.5px;background:var(--accent);color:var(--ink);padding:12px 20px}
  .read:hover{background:var(--accent-deep);color:var(--ink)}
  .read .arr{display:inline-block;transition:transform .3s cubic-bezier(.2,.8,.2,1)}
  .read:hover .arr{transform:translateX(3px)}
  .heroimg{overflow:hidden;margin:0}
  .heroimg img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 60%;border-bottom:12px solid var(--accent);transform-origin:center 60%}
  :global(html.js) .heroimg img{animation:settle 1.6s cubic-bezier(.2,.8,.2,1) both, drift 28s ease-in-out 1.6s infinite alternate}
  @keyframes settle{from{transform:scale(1.045);opacity:.001}to{transform:scale(1);opacity:1}}
  @keyframes drift{from{transform:scale(1)}to{transform:scale(1.03)}}
  :global(html.js) .hero .intro,:global(html.js) .hero .level,:global(html.js) .hero h1,:global(html.js) .hero .excerpt,:global(html.js) .hero .read{animation:rise .8s cubic-bezier(.2,.8,.2,1) both}
  :global(html.js) .hero .level{animation-delay:.08s}
  :global(html.js) .hero h1{animation-delay:.14s}
  :global(html.js) .hero .excerpt{animation-delay:.22s}
  :global(html.js) .hero .read{animation-delay:.3s}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @media (max-width:820px){.hero .wrap{grid-template-columns:1fr}.heroimg{order:2}.heroimg img{aspect-ratio:4/3;object-position:center 55%}}

  /* hear */
  .hear .wrap{padding-block:clamp(10px,2vw,20px) clamp(28px,4vw,52px)}
  .hearbox{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:stretch;border:2px solid var(--ink)}
  .hearbox>*{min-width:0}
  .hearbox img{display:block;width:100%;height:100%;object-fit:cover;min-height:240px}
  .hearcopy{padding:clamp(22px,3.5vw,40px);display:flex;flex-direction:column;justify-content:center;gap:14px;border-left:10px solid var(--accent)}
  .hearcopy h2{font-size:clamp(26px,3vw,34px)}
  .hearcopy p{color:var(--dim);max-width:46ch}
  .hearcopy .go{align-self:flex-start;font-weight:600;padding:12px 20px;background:var(--ink);color:#fff}
  .hearcopy .go:hover{background:#000;color:#fff}
  @media (max-width:720px){.hearbox{grid-template-columns:1fr}.hearbox img{height:auto;aspect-ratio:3/2;min-height:0}.hearcopy{border-left:0;border-top:10px solid var(--accent)}}

  /* sections */
  .sec .wrap{padding-block:clamp(26px,4vw,52px)}
  .sechead{display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding-bottom:14px;border-bottom:3px solid var(--ink)}
  .sechead .all{font-weight:600;font-size:16px;color:var(--dim);white-space:nowrap}
  .sechead .all:hover{color:var(--ink)}
  .subnote{color:var(--dim);margin-top:14px;max-width:60ch}
  .rows{list-style:none;margin-top:6px}
  .row{border-bottom:1px solid var(--line-soft)}
  .row a{display:grid;grid-template-columns:72px 200px minmax(0,1fr) auto;gap:clamp(16px,2.6vw,36px);padding-block:clamp(18px,2.4vw,26px);align-items:center}
  .row .mark{position:relative;width:72px;height:72px;display:block;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .row .mark img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
  .row .m-yel{transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .row a:hover .mark{transform:translateY(-1px)}
  .row a:hover .m-yel,.row a:focus-visible .m-yel{transform:translateY(-2px)}
  .row .name{font-family:var(--disp);font-weight:700;font-size:23px;line-height:1.15;display:block}
  .row .st{display:block;font-family:var(--grot);font-weight:400;font-size:14.5px;color:var(--dim);margin-top:3px}
  .row .desc{color:var(--dim);max-width:56ch;display:block}
  .row .go{font-weight:600;font-size:15.5px;white-space:nowrap;color:var(--dim)}
  .row a:hover .name{text-decoration:underline;text-decoration-color:var(--accent);text-decoration-thickness:4px;text-underline-offset:5px}
  .row a:hover .go{color:var(--ink)}
  @media (max-width:820px){.row a{grid-template-columns:56px minmax(0,1fr);row-gap:6px}.row .mark{width:56px;height:56px;grid-row:span 3;align-self:start}.row .go{margin-top:2px}}
  .wrow a{grid-template-columns:170px minmax(0,1fr)}
  .wrow .name{font-size:clamp(22px,2.6vw,30px)}
  .wrow .desc{margin-top:8px}
  .wrow .st{margin-top:0}
  @media (max-width:820px){.wrow a{grid-template-columns:1fr}}
  .writing .wrap{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(24px,5vw,64px);align-items:start}
  .writing>.wrap>*{min-width:0}
  .wimg{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;object-position:center;border-bottom:12px solid var(--accent)}
  @media (max-width:820px){.writing .wrap{grid-template-columns:1fr}.wimg{aspect-ratio:16/10;object-position:center 40%}}

  /* about */
  .about .wrap{display:grid;grid-template-columns:280px minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:start}
  .about>.wrap>*{min-width:0}
  .about img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 12%;border-bottom:10px solid var(--accent)}
  .about p{margin-top:16px;color:var(--dim);max-width:58ch}
  .about p.first{margin-top:20px;color:var(--ink);font-size:20px}
  .about .links{display:flex;gap:22px;margin-top:22px;font-weight:600;flex-wrap:wrap}
  .about .links a{border-bottom:3px solid var(--accent)}
  @media (max-width:720px){.about .wrap{grid-template-columns:1fr}.about img{max-width:240px}}

  /* subscribe */
  .sub .wrap{padding-block:clamp(20px,4vw,56px)}
  .subbox{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,420px);gap:clamp(20px,4vw,48px);align-items:center;padding:clamp(24px,4vw,44px);background:var(--accent)}
  .subbox>*{min-width:0}
  .subbox h2{font-size:clamp(30px,4vw,46px);max-width:14ch}
  .subbox p{margin-top:10px;color:var(--ink);max-width:40ch}
  .form{display:flex;gap:10px;flex-wrap:wrap}
  .form input{flex:1 1 200px;min-width:0;font:inherit;padding:13px 14px;border:2px solid var(--ink);background:#fff;color:var(--ink)}
  .form button{font:inherit;font-weight:600;padding:13px 20px;border:0;background:var(--ink);color:#fff;cursor:pointer}
  .form button:hover{background:#000}
  .form button:disabled{opacity:.6;cursor:default}
  .form .cap{flex-basis:100%;font-size:14px;color:var(--ink);opacity:.8}
  .form .cap.done{opacity:1;font-weight:600}
  @media (max-width:720px){.subbox{grid-template-columns:1fr}}
</style>
